# The image build needs only Maven inputs, Java/resources/tests and its probe.
# Keep docs, local configuration, private notes and runtime data out of context.
**
!pom.xml
!mvnw
!.mvn/
.mvn/**
!.mvn/wrapper/
.mvn/wrapper/**
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.jar
!src/
src/**
!src/main/
!src/main/**
!src/test/
!src/test/**
!tools/
tools/**
!tools/container/
tools/container/**
!tools/container/Healthcheck.java

# Exclusions still apply if a local file is placed under an allowed source tree.
**/.env
**/.env.*
**/secrets/**
**/.secrets/**
**/.aws/**
**/.kube/**
**/.codex/**
**/.agents/**
**/.local/**
**/.codex-scratch/**
**/private/**
**/backups/**
**/dumps/**
**/.idea/**
**/.vscode/**
**/.settings/**
**/*.iml
**/.terraform/**
**/*.tfstate*
**/*.dump
**/*.backup
**/*.sql.gz
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/*.cer
**/*.private.*
